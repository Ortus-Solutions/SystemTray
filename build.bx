/**
 * SystemTray build task runner.
 *
 * Everything about the build lives in box.json - version, dependencies, source paths, resources,
 * manifest and the fat jar settings. This file just drives it.
 *
 * Usage:
 *
 *     box task run build
 *
 * Produces dist/release/<version>/systemtray-<version>.jar
 */
class {

	function run() {
		command( "install" )
			.flags( "noSave", "force" )
			.run();

		command( "java compile" )
			.run();
	}

}