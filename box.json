{
    "name": "SystemTray",
    "slug": "systemtray",
    "version": "4.5.2",
    "author": "Ortus Solutions",
    "shortDescription": "Cross-platform SystemTray support for Swing/AWT, GtkStatusIcon and AppIndicator",
    "ProjectURL": "https://github.com/Ortus-Solutions/SystemTray",
    "license": [
        {
            "type": "Apache-2.0",
            "URL": "https://github.com/Ortus-Solutions/SystemTray/blob/master/LICENSE.txt"
        }
    ],
    "maven": {
        "installMode": "shared",
        "installDirectory": "dist/dependencies"
    },
    "dependencies": {
        "org.javassist:javassist": "maven:org.javassist:javassist:3.30.1-GA",
        "net.java.dev.jna:jna": "maven:net.java.dev.jna:jna:5.14.0",
        "net.java.dev.jna:jna-platform": "maven:net.java.dev.jna:jna-platform:5.14.0",
        "org.slf4j:slf4j-api": "maven:org.slf4j:slf4j-api:2.0.17"
    },
    "devDependencies": {
        "org.junit.platform:junit-platform-console-standalone": "maven:org.junit.platform:junit-platform-console-standalone:1.12.2"
    },
    "installPaths": {
        "org.junit.platform:junit-platform-console-standalone": "dist/test-dependencies/org.junit.platform-junit-platform-console-standalone"
    },
    "scripts": {
        "preJavaCompile": [
            "delete 'dist/classes,dist/release' --force --recurse"
        ]
    },
    "java": {
        "sourcePath": "src",
        "classesDirectory": "dist/classes",
        "libsDirectory": "dist/release/${@version}",
        "resourcesDirectory": [
            "src-resources"
        ],
        "testSourcePath": "test-junit",
        "testClassesDirectory": "dist/test-classes",
        "testResourcesDirectory": "test-resources",
        "classPath": "dist/dependencies",
        "compileOptions": {
            "release": "11",
            "encoding": "UTF-8"
        },
        "fatJar": true,
        "fatJarFile": "systemtray-${@version}.jar",
        "fatJarPaths": [
            "dist/dependencies"
        ],
        "manifest": {
            "Name": "SystemTray",
            "Specification-Title": "SystemTray",
            "Specification-Version": "${@version}",
            "Specification-Vendor": "Ortus Solutions",
            "Implementation-Title": "com.dorkbox.SystemTray",
            "Implementation-Version": "${@version}",
            "Implementation-Vendor": "Ortus Solutions",
            "Automatic-Module-Name": "dorkbox.systemtray"
        }
    }
}